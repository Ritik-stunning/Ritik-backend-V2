NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Default timeout (ms) for outbound HTTP calls made via src/lib/http
HTTP_TIMEOUT_MS=10000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_management

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_dev_access_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Email (if email provider is console it prints OTP to the log, no credentials needed, if you want real email provider use google as env var)
EMAIL_PROVIDER=console 
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_WORKSPACE_USER=no-reply@stunningdentistry.in
GOOGLE_WORKSPACE_APP_PASSWORD=
EMAIL_FROM=no-reply@stunningdentistry.in
EMAIL_FROM_NAME=Stunning Dentistry
# Data encryption (column-level PII encryption + blind-index dedup)
# Generate 32-byte base64 keys:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, source these from a secrets manager / KMS — never commit real keys.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
ENC_KEY_VERSION=1
DEFAULT_COUNTRY=IN
